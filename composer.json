{
  "name": "owebstudio/kirby-search-insights",
  "description": "Shows what visitors search for on your Kirby site, which searches find nothing and which results they open.",
  "type": "kirby-plugin",
  "license": "MIT",
  "keywords": [
    "owebstudio",
    "owebstudio-plugin",
    "kirby",
    "kirby6",
    "kirby-plugin",
    "search",
    "site-search",
    "search-analytics"
  ],
  "homepage": "https://github.com/owebstudio/kirby-search-insights",
  "support": {
    "issues": "https://github.com/owebstudio/kirby-search-insights/issues",
    "source": "https://github.com/owebstudio/kirby-search-insights"
  },
  "authors": [
    {
      "name": "oweb studio",
      "homepage": "https://github.com/owebstudio"
    }
  ],
  "require": {
    "php": "^8.3",
    "ext-pdo_sqlite": "*",
    "getkirby/composer-installer": "^1.2"
  },
  "require-dev": {
    "phpunit/phpunit": "^12.0"
  },
  "conflict": {
    "getkirby/cms": "<6.0"
  },
  "autoload-dev": {
    "classmap": [
      "lib/"
    ]
  },
  "config": {
    "allow-plugins": {
      "getkirby/composer-installer": true
    },
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true
  },
  "extra": {
    "kirby": {
      "compatible": "^6.0"
    }
  }
}
